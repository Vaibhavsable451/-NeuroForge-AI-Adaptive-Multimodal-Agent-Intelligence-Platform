# ---- LLM backend (Mixture-of-Experts real completions) ----------------
# Set GROQ_API_KEY to make every expert in app/moe/experts.py call the
# real Groq API (fast Llama 3.3 70B by default) instead of the
# deterministic offline fallback. Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Alternative provider — used only if GROQ_API_KEY is unset.


# Force a specific provider instead of auto-detecting from the keys
# above. One of: groq, anthropic. Leave unset for auto-detect.
LLM_PROVIDER=groq

# ---- Vector database (Hybrid Agentic RAG) ------------------------------
# Set PINECONE_API_KEY to store/retrieve documents in a real Pinecone
# serverless index (embeddings via Pinecone's hosted inference API —
# no local embedding model or GPU needed). Get a key at
# https://app.pinecone.io. If unset, the platform uses an in-memory
# TF-IDF vector store instead.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=neuroforge-ai
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=default
